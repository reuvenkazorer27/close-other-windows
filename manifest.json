{
  "manifest_version": 3,
  "name": "Close Other Windows",
  "version": "1.0",
  "description": "Close all other Chrome windows with one click. Keep only the current window open.",
  "permissions": ["windows", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
